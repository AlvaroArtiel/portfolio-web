---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Loader from '../components/Loader.astro'
import Footer from '../components/Footer.astro'
import MenuOverlay from '../components/MenuOverlay.astro'
import {altPath} from '../lib/routes'
import type {Lang} from '../lib/i18n'

export type Section = 'home' | 'expertise' | 'projects' | 'experience' | 'personal' | 'blog' | 'cv'

/** Default OG image filename (under /og/) per section; matches web/scripts/generate-og.mjs. */
const OG_IMAGE_BY_SECTION: Record<Section, string> = {
  home: '/og/home.png',
  expertise: '/og/especialidades.png',
  projects: '/og/proyectos.png',
  experience: '/og/experiencia.png',
  personal: '/og/personal.png',
  blog: '/og/blog.png',
  cv: '/og/cv.png',
}

interface Props {
  title: string
  description: string
  lang: Lang
  section: Section
  /** Optional accent override; by default the section decides via CSS. */
  accent?: string
  /** Set to true on pages that must not be indexed (e.g. /casa). */
  noindex?: boolean
  /** Optional OG image path/URL override; defaults per section, falling back to /og/default.png. */
  ogImage?: string
}

const {title, description, lang, section, accent, noindex = false, ogImage} = Astro.props

const pathname = Astro.url.pathname
const esUrl = altPath(pathname, 'es')
const enUrl = altPath(pathname, 'en')
const canonical = new URL(pathname, Astro.site ?? 'https://dev.alvaroartiel.com')
const ogImageUrl = new URL(
  ogImage ?? OG_IMAGE_BY_SECTION[section] ?? '/og/default.png',
  Astro.site ?? 'https://dev.alvaroartiel.com',
)
---

<!doctype html>
<html lang={lang} data-section={section} style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(esUrl, canonical)} />
    <link rel="alternate" hreflang="en" href={new URL(enUrl, canonical)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esUrl, canonical)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InstrumentSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="head" />
    <script is:inline>
      // Telón de marca: SOLO primera visita por sesión, decidido antes del
      // primer paint (el CSS del Loader solo actúa bajo html.aa-loading).
      try {
        if (!sessionStorage.getItem('aa-loaded')) document.documentElement.classList.add('aa-loading')
      } catch (e) {}
    </script>
  </head>
  <body>
    <Loader lang={lang} />
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <Header lang={lang} />
    <MenuOverlay lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <slot name="post-footer" />
    <script>
      import '../lib/motion'
      import {initCursor} from '../lib/cursor'
      initCursor()
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    text-decoration: none;
    transform: translateY(-300%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
</style>
