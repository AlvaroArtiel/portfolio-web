---
import Base from '../layouts/Base.astro'
import {ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import {pathFor} from '../lib/routes'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const heading = lang === 'en' ? 'Thank you' : 'Gracias'
const description =
  lang === 'en' ? 'Your message was sent successfully.' : 'Tu mensaje se ha enviado correctamente.'
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="home" noindex>
  <section class="thanks-page">
    <div class="thanks-copy">
      <h1>{dict.thanks_heading}</h1>
      <p class="thanks-line">{dict.thanks_line}</p>
      <p class="thanks-meanwhile">{dict.thanks_meanwhile}</p>
      <nav class="thanks-cta">
        <a href={pathFor('personal', lang)}>{dict.thanks_link_personal}</a>
        <a href={pathFor('blog', lang)}>{dict.thanks_link_blog}</a>
      </nav>
    </div>
    {/* Premio: el monograma celebra (WebGL lazy; sin capacidad → queda el texto, que ya es el momento) */}
    <div class="thanks-stage" data-thanks-stage aria-hidden="true"></div>
  </section>
</Base>

<script>
  import {mountScene} from '../lib/three-island'
  import {DURATION} from '../lib/motion-tokens'

  const stage = document.querySelector<HTMLElement>('[data-thanks-stage]')
  if (stage) {
    void mountScene(stage, () => import('../scenes/thanks-scene').then((m) => m.default), {eager: true})
  }

  // Confeti de bienvenida (una sola vez, respeta reduced-motion)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const colors = ['#D4FF3F', '#4FD1C5', '#B06CFF', '#F4F4F0']
    for (let i = 0; i < 26; i++) {
      const p = document.createElement('span')
      const size = 4 + Math.random() * 6
      const x = 20 + Math.random() * 60
      p.style.cssText = `position:fixed;left:${x}vw;top:-3vh;width:${size}px;height:${size * 0.6}px;background:${colors[i % colors.length]};pointer-events:none;z-index:70;border-radius:1px`
      document.body.appendChild(p)
      p.animate(
        [
          {transform: 'translateY(0) rotate(0deg)', opacity: 1},
          {transform: `translateY(${60 + Math.random() * 30}vh) rotate(${360 + Math.random() * 360}deg)`, opacity: 0},
        ],
        {
          duration: DURATION.section * 2200 + Math.random() * 1200,
          delay: Math.random() * 350,
          easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          fill: 'forwards',
        },
      ).onfinish = () => p.remove()
    }
  }
</script>

<style>
  .thanks-page {
    min-height: 80vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 78rem;
    margin-inline: auto;
  }

  .thanks-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .thanks-page h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .thanks-line {
    font-size: var(--step-body);
    color: var(--text-muted);
    max-width: 40ch;
    margin: 0;
  }
  .thanks-meanwhile {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 1.5rem 0 0;
  }
  .thanks-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .thanks-cta a {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--dur-micro) var(--ease-out-token);
  }
  .thanks-cta a:hover {
    color: var(--accent);
  }

  .thanks-stage {
    height: min(56vh, 30rem);
  }

  @media (max-width: 720px) {
    .thanks-page {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
    }
    .thanks-stage {
      height: 38vh;
    }
  }
</style>
