---
import Base from '../layouts/Base.astro'
import {ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'

interface Props {
  lang: Lang
}
const {lang} = Astro.props

const heading = ui[lang].nav_experience
const description =
  lang === 'en' ? 'Professional experience — full content coming in Phase 2.' : 'Experiencia profesional — contenido completo en la Fase 2.'
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="experience">
  <section class="stub">
    <h1>{heading}</h1>
  </section>
</Base>

<style>
  .stub {
    min-height: 60vh;
    display: grid;
    place-content: center;
    padding: clamp(1.5rem, 6vw, 4rem);
  }
  .stub h1 {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
  }
</style>
