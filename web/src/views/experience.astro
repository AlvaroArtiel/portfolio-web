---
import Base from '../layouts/Base.astro'
import {t, ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import {getExperiences, getProjects} from '../lib/queries'
import {urlFor} from '../lib/sanity'
import {pathFor} from '../lib/routes'
import {dateRange} from '../lib/dates'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const [experiences, projects] = await Promise.all([getExperiences(), getProjects()])

/** Map project _id -> {slug, title} to dereference relatedProjects refs. */
const projectById = new Map(projects.map((p) => [p._id, {slug: p.slug.current, title: t(p.title, lang)}]))

const heading = ui[lang].nav_experience
const description =
  lang === 'en'
    ? 'Professional experience of Álvaro Artiel: roles, companies and related projects.'
    : 'Experiencia profesional de Álvaro Artiel: roles, empresas y proyectos relacionados.'
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="experience">
  <section class="experience-page">
    <header class="experience-header" data-reveal>
      <h1>{heading}</h1>
    </header>

    <ol class="timeline">
      {
        experiences.map((exp) => {
          const company = t(exp.company, lang)
          const role = t(exp.role, lang)
          const location = t(exp.location, lang)
          const modality = t(exp.modality, lang)
          const summary = t(exp.summary, lang)
          const bullets = (exp.bullets ?? []).map((b) => t(b, lang)).filter(Boolean)
          const related = (exp.relatedProjects ?? [])
            .map((ref) => projectById.get(ref._ref))
            .filter((p): p is {slug: string; title: string} => Boolean(p))

          return (
            <li class="timeline-entry" data-reveal>
              {/* Columna izquierda: fechas + logo + ubicación, para que el carril
                  nunca deje un hueco vacío (B9). El contenido narrativo va a la
                  derecha de la línea, en .entry-body. */}
              <div class="entry-aside">
                <p class="entry-dates">{dateRange(exp.startDate, exp.endDate, lang, dict.present)}</p>
                {exp.logo && (
                  <img
                    class="entry-logo"
                    src={urlFor(exp.logo, {w: 160, h: 160}).url()}
                    alt=""
                    width="80"
                    height="80"
                    loading="lazy"
                  />
                )}
                {(location || modality) && (
                  <p class="entry-meta">{[location, modality].filter(Boolean).join(' · ')}</p>
                )}
              </div>
              <div class="entry-body">
                <h2 class="entry-role">{role}</h2>
                <p class="entry-company">{company}</p>
                {summary && <p class="entry-summary">{summary}</p>}
                {bullets.length > 0 && (
                  <ul class="entry-bullets">
                    {bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {related.length > 0 && (
                  <p class="entry-related">
                    <span class="entry-related-label">{dict.related_projects}</span>
                    <span class="entry-related-list">
                      {related.map((p) => (
                        <a href={`${pathFor('proyectos', lang)}${p.slug}/`}>{p.title}</a>
                      ))}
                    </span>
                  </p>
                )}
              </div>
            </li>
          )
        })
      }
    </ol>
  </section>
</Base>

<script>
  import {onReady, getMotion} from '../lib/motion'
  import {SCRUB} from '../lib/motion-tokens'

  // Línea de tiempo que se dibuja con el scroll (stroke-dashoffset + scrub).
  onReady(() => {
    const motion = getMotion()
    const timeline = document.querySelector<HTMLElement>('.timeline')
    if (!motion || !timeline) return
    const {gsap} = motion

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
    svg.classList.add('timeline-line')
    svg.setAttribute('aria-hidden', 'true')
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line')
    const height = timeline.offsetHeight - 16
    line.setAttribute('x1', '1.5')
    line.setAttribute('x2', '1.5')
    line.setAttribute('y1', '0')
    line.setAttribute('y2', String(height))
    line.setAttribute('stroke', 'var(--accent)')
    line.setAttribute('stroke-width', '3')
    line.setAttribute('stroke-linecap', 'round')
    line.style.strokeDasharray = String(height)
    line.style.strokeDashoffset = String(height)
    svg.appendChild(line)
    timeline.appendChild(svg)

    gsap.to(line, {
      strokeDashoffset: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: timeline,
        start: 'top 75%',
        end: 'bottom 60%',
        scrub: SCRUB,
      },
    })
  })
</script>

<style>
  .experience-page {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 60rem;
    margin-inline: auto;
  }

  .experience-header h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    margin: 0 0 clamp(3rem, 8vh, 5rem);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 7vh, 4rem);
    position: relative;
  }
  /* Carril estático (fallback sin JS / reduced-motion); la línea viva
     que se dibuja con el scroll la pinta el script encima. Vive en el
     carril central de la rejilla de cada entrada: 11rem (fechas) + 1.5rem
     (mitad del carril de 3rem) = centro de la columna de la línea. */
  .timeline::before {
    content: '';
    position: absolute;
    left: calc(11rem + 1.5rem);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--text-muted) 25%, transparent);
  }
  .timeline :global(.timeline-line) {
    position: absolute;
    left: calc(11rem + 1.5rem - 1px);
    top: 0.5rem;
    height: calc(100% - 1rem);
    width: 3px;
    overflow: visible;
    pointer-events: none;
  }

  /* Rejilla de cada entrada: fechas/logo a la izquierda de la línea,
     carril central vacío (ahí vive la línea, posicionada sobre .timeline),
     contenido a la derecha (B9: la columna izquierda deja de estar vacía). */
  .timeline-entry {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 3rem minmax(0, 1fr);
    align-items: start;
    position: relative;
  }

  .entry-aside {
    grid-column: 1;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .entry-logo {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: 4px;
    background: var(--bg-elevated);
    padding: 0.4rem;
  }

  /* Siempre en la columna de contenido, a la derecha de la línea */
  .entry-body {
    grid-column: 3;
  }

  .entry-dates {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0;
  }

  .entry-role {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .entry-company {
    font-size: var(--step-body);
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .entry-meta {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    margin: 0;
  }

  .entry-summary {
    font-size: var(--step-body);
    line-height: 1.55;
    max-width: 60ch;
    margin: 0 0 0.75rem;
  }

  .entry-bullets {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step-small);
  }

  /* Densidad alternante: las entradas pares llevan los bullets en un
     bloque visualmente más colapsado (letra y gap menores). El ritmo del
     timeline viene de esta alternancia de pesos, no de la línea. */
  .timeline-entry:nth-child(even) .entry-bullets {
    gap: 0.2rem;
    font-size: var(--step-mono-label);
  }

  .entry-related {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    margin: 0;
  }
  .entry-related-label {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    margin-right: 0.75rem;
  }
  .entry-related-list a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }
  .entry-related-list a:hover {
    color: var(--accent);
  }
  .entry-related-list a:not(:last-child)::after {
    content: ' · ';
    color: var(--text-muted);
    text-decoration: none;
  }

  /* Móvil: vuelve a una columna. La línea se queda a la izquierda (como
     antes de B9) y las fechas quedan encima del rol, no al lado. */
  @media (max-width: 560px) {
    .timeline::before,
    .timeline :global(.timeline-line) {
      left: 1.75rem;
    }
    .timeline :global(.timeline-line) {
      left: calc(1.75rem - 1px);
    }
    .timeline-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      padding-left: 2.75rem;
    }
    .entry-aside {
      grid-column: 1;
      gap: 0.4rem;
    }
    .entry-body {
      grid-column: 1;
    }
    .entry-logo {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
