---
import Base from '../layouts/Base.astro'
import {t, ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import {getExperiences, getProjects} from '../lib/queries'
import {urlFor} from '../lib/sanity'
import {pathFor} from '../lib/routes'
import {dateRange} from '../lib/dates'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const [experiences, projects] = await Promise.all([getExperiences(), getProjects()])

/** Map project _id -> datos para enlace + preview flotante. */
const projectById = new Map(
  projects.map((p) => [
    p._id,
    {
      slug: p.slug.current,
      title: t(p.title, lang),
      preview: p.cover ? urlFor(p.cover, {w: 560, h: 372}).url() : '',
    },
  ]),
)

/**
 * Métrica protagonista por etapa (sesión 3 §3.1). SOLO hechos respaldados por
 * el material fuente: los números salen del spec §9/elevación §2; donde no hay
 * número respaldado, el protagonista es el entregable/rasgo del propio seed.
 */
const METRIC: Record<string, {es: string; en: string}> = {
  'experience-tentuplaza': {es: '+5.000 alumnos', en: '5,000+ students'},
  'experience-ceustack': {es: '3 productos propios', en: '3 products of our own'},
  'experience-consultor-independiente': {es: '+40 proyectos', en: '40+ projects'},
  'experience-esperando-render': {es: 'Consultoría e-learning', en: 'E-learning consulting'},
  'experience-auraprods': {es: 'Campus e-learning', en: 'E-learning campus'},
  'experience-iurban': {es: 'CRM + design system', en: 'CRM + design system'},
  'experience-8pecados': {es: 'Cliente real, plazo real', en: 'Real client, real deadline'},
}

// Viaje temporal: orden cronológico ascendente (2018 → hoy). El seed ordena
// "actualidad primero" (order asc); el viaje lo recorre al revés. El CV
// mantiene el orden inverso clásico — divorcio deliberado (decisions.md).
const stages = [...experiences].sort((a, b) => (b.order ?? 0) - (a.order ?? 0))

const yearOf = (startDate?: string): string => startDate?.match(/\d{4}/)?.[0] ?? ''
const CODA_YEAR = String(new Date().getFullYear())

const heading = ui[lang].nav_experience

const years = stages.map((exp) => yearOf(exp.startDate)).filter(Boolean).map(Number)
const firstYear = years.length > 0 ? Math.min(...years) : null
const countLine =
  lang === 'en'
    ? `${experiences.length} chapters${firstYear ? ` · since ${firstYear}` : ''}`
    : `${experiences.length} etapas${firstYear ? ` · desde ${firstYear}` : ''}`

const description =
  lang === 'en'
    ? 'Professional experience of Álvaro Artiel: roles, companies and related projects.'
    : 'Experiencia profesional de Álvaro Artiel: roles, empresas y proyectos relacionados.'
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="experience">
  <section class="journey-page">
    <header class="journey-header" data-reveal>
      <h1>{heading}</h1>
      <p class="page-count">{countLine}</p>
    </header>

    <div class="journey" data-journey>
      {/* Carril del año gigante: decorativo (los años viven en cada etapa),
          sticky al lateral, detrás del contenido. Solo existe visualmente
          cuando el odómetro JS manda (.is-live); su fallback son los
          .stage-year en flujo. */}
      <div class="journey-rail" aria-hidden="true">
        <span class="rail-year" data-journey-year>{yearOf(stages[0]?.startDate) || CODA_YEAR}</span>
      </div>

      <ol class="stages">
        {
          stages.map((exp, i) => {
            const company = t(exp.company, lang)
            const role = t(exp.role, lang)
            const location = t(exp.location, lang)
            const modality = t(exp.modality, lang)
            const summary = t(exp.summary, lang)
            const bullets = (exp.bullets ?? []).map((b) => t(b, lang)).filter(Boolean)
            const metric = METRIC[exp._id]?.[lang]
            const year = yearOf(exp.startDate)
            const prevYear = i > 0 ? yearOf(stages[i - 1].startDate) : ''
            const showYear = year !== prevYear
            const related = (exp.relatedProjects ?? [])
              .map((ref) => projectById.get(ref._ref))
              .filter((p): p is {slug: string; title: string; preview: string} => Boolean(p))

            return (
              <li class="stage" data-year={year} data-reveal>
                {showYear && (
                  <p class="stage-year" aria-hidden="true">
                    {year}
                  </p>
                )}
                <p class="stage-kicker">
                  {dateRange(exp.startDate, exp.endDate, lang, dict.present)}
                  {(location || modality) && ` · ${[location, modality].filter(Boolean).join(' · ')}`}
                </p>
                {exp.logo ? (
                  <img
                    class="stage-logo"
                    src={urlFor(exp.logo, {w: 240, h: 240}).url()}
                    alt={company}
                    width="120"
                    height="120"
                    loading="lazy"
                  />
                ) : (
                  <p class="stage-brand">{company}</p>
                )}
                <h2 class="stage-role">{role}</h2>
                {metric && <p class="stage-metric">{metric}</p>}
                {summary && <p class="stage-summary">{summary}</p>}
                {bullets.length > 0 && (
                  <details class="stage-details">
                    <summary>{dict.see_detail}</summary>
                    <ul class="stage-bullets">
                      {bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </details>
                )}
                {related.length > 0 && (
                  <p class="stage-related">
                    <span class="stage-related-label">{dict.related_projects}</span>
                    <span class="stage-related-list">
                      {related.map((p) => (
                        <a
                          href={`${pathFor('proyectos', lang)}${p.slug}/`}
                          data-preview-src={p.preview || undefined}
                          data-preview-alt={p.title}
                        >
                          {p.title}
                        </a>
                      ))}
                    </span>
                  </p>
                )}
              </li>
            )
          })
        }

        {/* Coda: el viaje termina hoy, mirando adelante. */}
        <li class="stage stage-coda" data-year={CODA_YEAR}>
          <p class="stage-year" aria-hidden="true">{CODA_YEAR}</p>
          <p class="coda-line">{dict.journey_coda}</p>
          <a class="coda-link" href={pathFor('contacto', lang)}>{dict.journey_coda_cta}</a>
        </li>
      </ol>
    </div>
  </section>
</Base>

<script>
  import {initJourneyYear} from '../lib/journey-year'
  import {initHoverPreview} from '../lib/hover-preview'

  const journey = document.querySelector<HTMLElement>('[data-journey]')
  const display = document.querySelector<HTMLElement>('[data-journey-year]')
  if (journey && display) {
    initJourneyYear({
      journey,
      display,
      stages: Array.from(journey.querySelectorAll<HTMLElement>('.stage')),
    })
  }
  initHoverPreview()
</script>

<style>
  .journey-page {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 78rem;
    margin-inline: auto;
  }

  .journey-header h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }

  .page-count {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0 0 clamp(3rem, 8vh, 5rem);
  }

  /* ------------------------------------------------------------------ */
  /* El viaje: carril sticky del año + columna de etapas                 */
  /* ------------------------------------------------------------------ */
  .journey {
    display: grid;
    grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
  }

  /* El rail SIEMPRE ocupa su columna (display) — ocultarlo con display:none
     dejaba a .stages auto-colocarse en la columna 1 y saltar a la 2 al
     activarse el odómetro (CLS 0.18 medido). Solo se enciende con opacity. */
  .journey-rail {
    grid-column: 1;
    align-self: start;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    pointer-events: none;
    opacity: 0;
  }
  .journey.is-live .journey-rail {
    opacity: 1;
  }
  /* Sin odómetro posible (reduced-motion): el documento decide su layout
     final antes del primer paint — una columna, años en flujo. */
  @media (prefers-reduced-motion: reduce) {
    .journey {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey-rail {
      display: none;
    }
  }

  .rail-year {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: clamp(9rem, 12.5vw, 13rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--accent) 26%, transparent);
    display: flex;
  }
  /* Odómetro (lo construye journey-year.ts) */
  .rail-year :global(.jy-col) {
    display: block;
    height: 1em;
    width: 0.71em; /* columnas iguales al ancho del dígito más ancho ("0" = 0.702em
       en esta fuente a peso 620): con 0.58em los glifos salían recortados por los lados */
    overflow: hidden;
    text-align: center;
  }
  .rail-year :global(.jy-reel) {
    display: flex;
    flex-direction: column;
  }
  .rail-year :global(.jy-reel span) {
    display: block;
    height: 1em;
  }

  .stages {
    grid-column: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .stages {
      grid-column: 1;
    }
  }

  /* Cada etapa es una mini-escena: respira como una escena, no como una fila. */
  .stage {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  /* Año en flujo: cabecera de etapa en móvil y fallback sin odómetro
     (sin JS o reduced-motion). Cuando el carril está vivo, desaparece. */
  .stage-year {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: clamp(4.5rem, 18vw, 8rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--accent) 26%, transparent);
    margin: 0 0 1.5rem;
  }
  /* visibility (no display): conserva la geometría exacta cuando el odómetro
     toma el relevo — cambiarlo con display provocaba CLS 0.18 (medido). */
  .journey.is-live .stage-year {
    visibility: hidden;
  }

  .stage-kicker {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .stage-logo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    border-radius: 6px;
    background: var(--surface-1);
    padding: 0.5rem;
    margin: 0 0 0.75rem;
  }
  /* Wordmark: la marca presente sin logo — sello tipográfico, no un h2 más. */
  .stage-brand {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .stage-role {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }

  /* La métrica es la protagonista tipográfica de la escena. */
  .stage-metric {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .stage-summary {
    font-size: var(--step-body);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0 0 1rem;
  }

  .stage-details {
    margin: 0 0 1rem;
    max-width: 56ch;
  }
  .stage-details summary {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    transition: color var(--dur-micro) var(--ease-out-token);
  }
  .stage-details summary::-webkit-details-marker {
    display: none;
  }
  .stage-details summary::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
    transition: transform var(--dur-micro) var(--ease-out-token);
  }
  .stage-details[open] summary::before {
    transform: rotate(45deg);
  }
  .stage-details summary:hover {
    color: var(--text);
  }
  .stage-bullets {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step-small);
  }

  .stage-related {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    margin: 0;
  }
  .stage-related-label {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    margin-right: 0.75rem;
  }
  .stage-related-list a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }
  .stage-related-list a:hover {
    color: var(--accent);
  }
  .stage-related-list a:not(:last-child)::after {
    content: ' · ';
    color: var(--text-muted);
    text-decoration: none;
  }

  /* Coda: cierre corto, mirando adelante. */
  .stage-coda {
    min-height: 50vh;
  }
  .coda-line {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .coda-link {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    width: fit-content;
  }

  /* ------------------------------------------------------------------ */
  /* Móvil: una columna; el año gigante pasa a cabecera de etapa         */
  /* ------------------------------------------------------------------ */
  @media (max-width: 720px) {
    .journey {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey-rail,
    .journey.is-live .journey-rail {
      display: none;
    }
    .stages {
      grid-column: 1;
    }
    /* En móvil el año en flujo manda siempre, odómetro o no. */
    .journey.is-live .stage-year {
      visibility: visible;
    }
    .stage {
      min-height: 0;
      padding-block: clamp(2.5rem, 8vh, 4rem);
      justify-content: flex-start;
    }
  }
</style>
