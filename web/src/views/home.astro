---
import Base from '../layouts/Base.astro'
import Hero from '../components/home/Hero.astro'
import About from '../components/home/About.astro'
import FeaturedDeck from '../components/home/FeaturedDeck.astro'
import GamificationBand from '../components/home/GamificationBand.astro'
import Manifesto from '../components/home/Manifesto.astro'
import CtaBand from '../components/home/CtaBand.astro'
import PersonalTeaser from '../components/home/PersonalTeaser.astro'
import PostFooter from '../components/PostFooter.astro'
import type {Lang} from '../lib/i18n'
import {t} from '../lib/i18n'
import {getSiteSettings, getProjects, getChaptersWithItems} from '../lib/queries'

interface Props {
  lang: Lang
}
const {lang} = Astro.props

const settings = await getSiteSettings()
const allProjects = await getProjects()
const featured = allProjects.filter((p) => p.featured).slice(0, 4)
// Proyectos con la especialidad de gamificación (fuente única: la etiqueta del stack).
const gamified = allProjects.filter((p) => (p.stack ?? []).includes('Gamificación'))
const chapters = await getChaptersWithItems()
const teaserItems = chapters.flatMap((chapter) => chapter.items.slice(0, 1))

const title = t(settings?.seoTitle, lang) ||
  (lang === 'en'
    ? 'Álvaro Artiel — Product design consulting, gamification & digital project management'
    : 'Álvaro Artiel — Consultoría de diseño de producto, gamificación y gestión de proyectos digitales')
const description = t(settings?.seoDescription, lang) ||
  (lang === 'en'
    ? 'Digital product consultant: end-to-end product design, gamification and digital project management.'
    : 'Consultor de producto digital: diseño de producto, gamificación y gestión de proyectos digitales de punta a punta.')

const siteUrl = Astro.site ?? new URL('https://dev.alvaroartiel.com')

// Person JSON-LD (schema.org). Real social profiles only — the seeded
// placeholders in Sanity use '#' URLs and must not leak into sameAs.
const sameAs = (settings?.socials ?? [])
  .filter((s) => s.visible !== false && s.url && s.url !== '#')
  .map((s) => s.url)

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Álvaro Artiel',
  url: siteUrl.toString(),
  jobTitle: 'Product Lead & Digital Product Designer',
  email: settings?.email ? `mailto:${settings.email}` : 'mailto:soy@alvaroartiel.com',
  knowsAbout: [
    'Gamification',
    'Gamificación',
    'Product Design',
    'Consultoría de diseño de producto',
    'Gestión de proyectos digitales',
    'Product Management',
    'UX/UI Design',
    'E-learning',
    'SaaS',
  ],
  ...(sameAs.length > 0 && {sameAs}),
}

const jsonLdHome = JSON.stringify(personLd).replace(/</g, '\\u003c')
---

<Base title={title} description={description} lang={lang} section="home">
  <script type="application/ld+json" slot="head" is:inline set:html={jsonLdHome} />
  <Hero lang={lang} settings={settings} />
  <About lang={lang} settings={settings} />
  <FeaturedDeck lang={lang} projects={featured} />
  {gamified.length > 0 && <GamificationBand lang={lang} projects={gamified} />}
  <!-- Orden narrativo del camaleón (spec §5.3): deck azul → teaser naranja
       → CTA/contacto lima (el CTA queda pegado al footer de contacto). -->
  <Manifesto lang={lang} />
  <PersonalTeaser lang={lang} items={teaserItems} />
  <CtaBand lang={lang} />
  <PostFooter slot="post-footer" lang={lang} />
</Base>

<script>
  import {initChameleon} from '../lib/chameleon'

  // Camaleón intra-página (A3): el acento muta DURANTE el scroll —
  // hero lima → deck azul → CTA/contacto lima → teaser naranja → cierre lima.
  initChameleon([
    {selector: '.hero', accent: '#d4ff3f'},
    {selector: '.featured', accent: '#5b8cff'},
    {selector: '.gamification', accent: '#d4ff3f'},
    {selector: '.personal-teaser', accent: '#ff7847'},
    {selector: '.cta-band', accent: '#d4ff3f'},
  ])
</script>
