---
import Base from '../layouts/Base.astro'
import type {Lang} from '../lib/i18n'

interface Props {
  lang: Lang
}
const {lang} = Astro.props

const title =
  lang === 'en'
    ? 'Álvaro Artiel — Digital product design & development'
    : 'Álvaro Artiel — Diseño y desarrollo de productos digitales'
const description =
  lang === 'en'
    ? "Álvaro Artiel's portfolio: end-to-end digital product design and development."
    : 'Portfolio de Álvaro Artiel: diseño y desarrollo de productos digitales de punta a punta.'
const heading = lang === 'en' ? 'End-to-end digital product design' : 'Diseño productos digitales de punta a punta'
const subheading = lang === 'en' ? 'Site under construction — Phase 1' : 'Web en construcción — Fase 1'
---

<Base title={title} description={description} lang={lang} section="home">
  <!-- Placeholder: la home real llega en la Fase 2 -->
  <section class="placeholder-hero">
    <h1>{heading}</h1>
    <p>{subheading}</p>
  </section>
</Base>

<style>
  .placeholder-hero {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: clamp(1.5rem, 6vw, 4rem);
  }
  .placeholder-hero h1 {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .placeholder-hero p {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
  }
</style>
