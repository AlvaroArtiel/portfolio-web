---
import Base from '../layouts/Base.astro'
import Hero from '../components/home/Hero.astro'
import About from '../components/home/About.astro'
import FeaturedDeck from '../components/home/FeaturedDeck.astro'
import CtaBand from '../components/home/CtaBand.astro'
import PersonalTeaser from '../components/home/PersonalTeaser.astro'
import PostFooter from '../components/PostFooter.astro'
import type {Lang} from '../lib/i18n'
import {t} from '../lib/i18n'
import {getSiteSettings, getProjects, getChaptersWithItems} from '../lib/queries'

interface Props {
  lang: Lang
}
const {lang} = Astro.props

const settings = await getSiteSettings()
const featured = (await getProjects()).filter((p) => p.featured).slice(0, 4)
const chapters = await getChaptersWithItems()
const teaserItems = chapters.flatMap((chapter) => chapter.items.slice(0, 1))

const title = t(settings?.seoTitle, lang) ||
  (lang === 'en'
    ? 'Álvaro Artiel — Digital product design & development'
    : 'Álvaro Artiel — Diseño y desarrollo de productos digitales')
const description = t(settings?.seoDescription, lang) ||
  (lang === 'en'
    ? "Álvaro Artiel's portfolio: end-to-end digital product design and development."
    : 'Portfolio de Álvaro Artiel: diseño y desarrollo de productos digitales de punta a punta.')

const siteUrl = Astro.site ?? new URL('https://dev.alvaroartiel.com')

// Person JSON-LD (schema.org). Real social profiles only — the seeded
// placeholders in Sanity use '#' URLs and must not leak into sameAs.
const sameAs = (settings?.socials ?? [])
  .filter((s) => s.visible !== false && s.url && s.url !== '#')
  .map((s) => s.url)

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Álvaro Artiel',
  url: siteUrl.toString(),
  jobTitle: 'Product Lead & Digital Product Designer',
  email: settings?.email ? `mailto:${settings.email}` : 'mailto:soy@alvaroartiel.com',
  ...(sameAs.length > 0 && {sameAs}),
}
---

<Base title={title} description={description} lang={lang} section="home">
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(personLd)} />
  <Hero lang={lang} settings={settings} />
  <About lang={lang} settings={settings} />
  <FeaturedDeck lang={lang} projects={featured} />
  <CtaBand lang={lang} />
  <PersonalTeaser lang={lang} items={teaserItems} />
  <PostFooter slot="post-footer" lang={lang} />
</Base>
