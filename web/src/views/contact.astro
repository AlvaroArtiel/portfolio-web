---
import Base from '../layouts/Base.astro'
import {ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import {getSiteSettings} from '../lib/queries'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const settings = await getSiteSettings()
const email = settings?.email ?? 'soy@alvaroartiel.com'
const socials = (settings?.socials ?? []).filter((s) => s.visible !== false)

const heading = dict.nav_contact
const description =
  lang === 'en'
    ? 'Get in touch about a project, a role, or just to say hi.'
    : 'Escríbeme para hablar de un proyecto, una vacante o simplemente para saludar.'

/**
 * Mad-lib conversacional (sesión 3 §3.3): el formulario ES la demo de diseño
 * de interacción. Una frase display con los campos incrustados; accesible
 * (labels reales sr-only, orden de foco natural, validación con voz) y con
 * fallback sin JS (POST clásico a /api/contact.php).
 */
const topics = [
  {value: 'producto', label: dict.madlib_topic_product},
  {value: 'web', label: dict.madlib_topic_web},
  {value: 'idea', label: dict.madlib_topic_idea},
  {value: 'otra', label: dict.madlib_topic_other},
]
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="home">
  <section class="contact-page">
    <div class="contact-grid">
      <form
        class="madlib"
        method="post"
        action="/api/contact.php"
        data-madlib
        data-flying={dict.send_flying}
        data-topic-pre={dict.madlib_topic_pre}
      >
        <input type="hidden" name="lang" value={lang} />

        <p class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </p>

        <h1 class="sr-only">{heading}</h1>

        <p class="madlib-line">
          <span>{dict.madlib_intro}</span>
          <label class="sr-only" for="ml-name">{dict.madlib_name_label}</label>
          <input
            class="ml-input ml-name"
            id="ml-name"
            type="text"
            name="name"
            required
            minlength="2"
            autocomplete="name"
            placeholder={dict.madlib_name_ph}
            data-error={dict.err_name}
            aria-describedby="ml-name-hint"
          /><span>.</span>
        </p>
        <span class="ml-hint" id="ml-name-hint" role="status"></span>

        <p class="madlib-line">
          <span>{dict.madlib_topic_pre}</span>
          <label class="sr-only" for="ml-topic">{dict.madlib_topic_label}</label>
          <span class="ml-select-wrap">
            <select class="ml-input ml-select" id="ml-topic" name="topic">
              {topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
            </select>
          </span>
          <span>{dict.madlib_tell}</span>
        </p>

        <label class="sr-only" for="ml-message">{dict.madlib_message_label}</label>
        <textarea
          class="ml-input ml-message"
          id="ml-message"
          name="message"
          required
          minlength="10"
          rows="2"
          placeholder={dict.madlib_message_ph}
          data-error={dict.err_message}
          aria-describedby="ml-message-hint"></textarea>
        <span class="ml-hint" id="ml-message-hint" role="status"></span>

        <p class="madlib-line">
          <span>{dict.madlib_reply}</span>
          <label class="sr-only" for="ml-email">{dict.madlib_email_label}</label>
          <input
            class="ml-input ml-email"
            id="ml-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={dict.madlib_email_ph}
            data-error={dict.err_email}
            aria-describedby="ml-email-hint"
          /><span>.</span>
        </p>
        <span class="ml-hint" id="ml-email-hint" role="status"></span>

        <button type="submit" class="submit" data-submit>
          <span data-submit-label>{dict.send_rest}</span>
        </button>
      </form>

      {/* -------- Panel lateral vivo -------- */}
      <aside class="contact-panel" data-reveal>
        <p class="panel-heading">{dict.panel_heading}</p>
        <button class="panel-email" type="button" data-copy-email data-copied={dict.panel_copied} title={dict.panel_copy_hint}>
          <span class="panel-email-text">{email}</span>
          <span class="panel-email-hint">{dict.panel_copy_hint}</span>
        </button>
        {
          socials.length > 0 && (
            <ul class="panel-socials">
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="panel-reply">{dict.panel_reply_time}</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import {DURATION} from '../lib/motion-tokens'

  const form = document.querySelector<HTMLFormElement>('[data-madlib]')

  // --- Autosize: los huecos de la frase crecen con lo escrito -------------
  const autosize = (input: HTMLInputElement): void => {
    const mirror = document.createElement('span')
    const style = getComputedStyle(input)
    mirror.style.cssText = `position:absolute;visibility:hidden;white-space:pre;font:${style.font};letter-spacing:${style.letterSpacing}`
    document.body.appendChild(mirror)
    const fit = (): void => {
      mirror.textContent = input.value || input.placeholder || ''
      input.style.width = `${Math.min(mirror.offsetWidth + 24, input.parentElement?.clientWidth ?? 600)}px`
    }
    input.addEventListener('input', fit)
    fit()
    // La fuente display carga tarde: re-medir cuando esté lista
    void document.fonts.ready.then(fit)
  }
  document.querySelectorAll<HTMLInputElement>('.ml-name, .ml-email').forEach(autosize)

  const message = document.querySelector<HTMLTextAreaElement>('.ml-message')
  message?.addEventListener('input', () => {
    message.style.height = 'auto'
    message.style.height = `${message.scrollHeight}px`
  })

  // --- Validación inline con voz ------------------------------------------
  document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-error]').forEach((field) => {
    const hint = document.getElementById(field.getAttribute('aria-describedby') ?? '')
    field.addEventListener('invalid', (e) => {
      e.preventDefault()
      field.setAttribute('aria-invalid', 'true')
      if (hint) hint.textContent = field.dataset.error ?? ''
      if (!document.querySelector('[aria-invalid="true"]:focus')) field.focus()
    })
    field.addEventListener('input', () => {
      if (field.checkValidity()) {
        field.removeAttribute('aria-invalid')
        if (hint) hint.textContent = ''
      }
    })
  })

  // --- Envío: el select se concatena al mensaje + botón en viaje -----------
  form?.addEventListener('submit', () => {
    const topic = form.querySelector<HTMLSelectElement>('.ml-select')
    const msg = form.querySelector<HTMLTextAreaElement>('.ml-message')
    if (topic && msg) {
      const label = topic.options[topic.selectedIndex]?.text ?? ''
      msg.value = `[${form.dataset.topicPre} ${label}] ${msg.value}`
      // topic viaja dentro de message; el backend solo conoce name/email/message
      topic.disabled = true
    }
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]')
    const label = form.querySelector<HTMLElement>('[data-submit-label]')
    if (submitButton && label) {
      submitButton.classList.add('is-flying')
      label.textContent = form.dataset.flying ?? label.textContent
    }
  })

  // --- Email gigante: copiar + microexplosión ------------------------------
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]')
  copyButton?.addEventListener('click', async () => {
    const text = copyButton.querySelector<HTMLElement>('.panel-email-text')
    if (!text) return
    try {
      await navigator.clipboard.writeText(text.textContent?.trim() ?? '')
    } catch {
      return
    }
    const original = text.textContent
    text.textContent = copyButton.dataset.copied ?? original
    window.setTimeout(() => {
      text.textContent = original
    }, 1800)

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    // Microexplosión de partículas lima (WAAPI, duración de elemento del sistema)
    const rect = copyButton.getBoundingClientRect()
    for (let i = 0; i < 14; i++) {
      const p = document.createElement('span')
      const size = 3 + Math.random() * 4
      p.style.cssText = `position:fixed;left:${rect.left + rect.width / 2}px;top:${rect.top + rect.height / 2}px;width:${size}px;height:${size}px;border-radius:1px;background:var(--accent);pointer-events:none;z-index:70`
      document.body.appendChild(p)
      const angle = Math.random() * Math.PI * 2
      const dist = 40 + Math.random() * 90
      p.animate(
        [
          {transform: 'translate(0,0) rotate(0deg)', opacity: 1},
          {transform: `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist - 30}px) rotate(${Math.random() * 360}deg)`, opacity: 0},
        ],
        {duration: DURATION.element * 1600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards'},
      ).onfinish = () => p.remove()
    }
  })
</script>

<style>
  .contact-page {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(5rem, 12vh, 7rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
    max-width: 78rem;
    margin-inline: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* -------- La frase -------- */
  .madlib {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(1.6rem, 3.4vw, 2.9rem);
    letter-spacing: -0.02em;
    line-height: 1.45;
  }
  .madlib-line {
    margin: 0 0 0.5em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
  }

  .ml-input {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--accent);
    border-radius: 0;
    padding: 0 0.1em 0.05em;
    min-width: 5ch;
    max-width: 100%;
  }
  .ml-input::placeholder {
    color: color-mix(in srgb, var(--text-muted) 75%, transparent);
  }
  .ml-input:focus-visible {
    outline: none;
    border-bottom-color: var(--text);
  }
  .ml-input[aria-invalid='true'] {
    border-bottom-style: dashed;
  }

  .ml-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: baseline;
  }
  .ml-select {
    appearance: none;
    cursor: pointer;
    padding-right: 1.1em;
  }
  .ml-select-wrap::after {
    content: '▾';
    position: absolute;
    right: 0.15em;
    bottom: 0.18em;
    font-size: 0.55em;
    color: var(--accent);
    pointer-events: none;
  }
  .ml-select option {
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-text);
    font-size: 1rem;
  }

  .ml-message {
    display: block;
    width: 100%;
    max-width: 26ch;
    resize: none;
    overflow: hidden;
    margin: 0 0 0.5em;
    line-height: 1.35;
  }

  .ml-hint {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--accent);
    min-height: 1.4em;
    margin: -0.35em 0 0.35em;
  }

  .submit {
    margin-top: 0.75em;
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--bg);
    background: var(--accent);
    padding: 0.85rem 2rem;
    border-radius: 999px;
    border: 0;
    cursor: pointer;
    transition:
      opacity var(--dur-micro) var(--ease-out-token),
      transform var(--dur-micro) var(--ease-out-token);
  }
  .submit:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }
  .submit.is-flying {
    opacity: 0.7;
    pointer-events: none;
    transform: translateY(-6px) rotate(-2deg);
  }

  /* -------- Panel lateral -------- */
  .contact-panel {
    display: grid;
    gap: 1.5rem;
    background: var(--surface-1);
    border: var(--border-soft);
    border-radius: 8px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .panel-heading {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
  }
  .panel-email {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
    display: grid;
    gap: 0.35rem;
  }
  .panel-email-text {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    letter-spacing: -0.02em;
    color: var(--text);
    word-break: break-all;
    transition: color var(--dur-micro) var(--ease-out-token);
  }
  .panel-email:hover .panel-email-text {
    color: var(--accent);
  }
  .panel-email-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .panel-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .panel-socials a {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }
  .panel-socials a:hover {
    color: var(--accent);
  }
  .panel-reply {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    margin: 0;
  }

  /* -------- Móvil -------- */
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .madlib {
      font-size: clamp(1.4rem, 6.2vw, 1.8rem);
    }
    .ml-message {
      max-width: 100%;
    }
    .ml-input {
      min-height: 44px;
    }
    .ml-select {
      min-height: 0;
    }
  }
</style>
