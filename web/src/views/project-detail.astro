---
import Base from '../layouts/Base.astro'
import HeroMedia from '../components/projects/HeroMedia.astro'
import BodyBlocks from '../components/projects/BodyBlocks.astro'
import NextProject from '../components/projects/NextProject.astro'
import type {Lang} from '../lib/i18n'
import {t, ui} from '../lib/i18n'
import type {Project} from '../lib/queries'
import {getServiceForProject} from '../lib/queries'
import {pathFor} from '../lib/routes'

interface Props {
  lang: Lang
  project: Project
}
const {lang, project} = Astro.props
const dict = ui[lang]

const title = t(project.title, lang)
const summary = t(project.summary, lang)
const role = t(project.role, lang)
const body = project.body?.[lang] ?? project.body?.es ?? []
const media = project.heroMedia ?? []

const categoryLabels: Record<string, {es: string; en: string}> = {
  propio: {es: 'Producto propio', en: 'Own product'},
  cliente: {es: 'Cliente', en: 'Client'},
  formacion: {es: 'Formación', en: 'Training'},
  personal: {es: 'Personal', en: 'Personal'},
}
const category = project.category ? categoryLabels[project.category]?.[lang] : undefined

// Enlace inverso al hub SEO: la especialidad que referencia este proyecto.
const service = await getServiceForProject(project._id)

// CreativeWork JSON-LD (schema.org) for the project detail page.
const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: summary || title,
  ...(project.year && {dateCreated: String(project.year)}),
  author: {
    '@type': 'Person',
    name: 'Álvaro Artiel',
  },
}

const jsonLdProject = JSON.stringify(creativeWorkLd).replace(/</g, '\\u003c')
---

<Base title={`${title} — Álvaro Artiel`} description={summary || title} lang={lang} section="projects">
  <script type="application/ld+json" slot="head" is:inline set:html={jsonLdProject} />
  {/* Progreso sticky del caso (sesión 3 §3.7-11b): posición 1:1 con el scroll */}
  <div class="case-progress" data-case-progress aria-hidden="true"></div>
  <article class="project-detail">
    <!-- Nivel 1: sección superior curada — título + metadatos + 2-3 heroMedia compuestas -->
    <header class="pd-hero" data-reveal>
      <div class="pd-heading">
        <p class="pd-breadcrumb">
          <a href={pathFor('proyectos', lang)}>← {dict.back_to_projects}</a>
        </p>
        <h1>{title}</h1>
        <dl class="pd-meta">
          {
            project.year && (
              <div>
                <dt>{lang === 'en' ? 'Year' : 'Año'}</dt>
                <dd>{project.year}</dd>
              </div>
            )
          }
          {
            role && (
              <div>
                <dt>{lang === 'en' ? 'Role' : 'Rol'}</dt>
                <dd>{role}</dd>
              </div>
            )
          }
          {
            category && (
              <div>
                <dt>{lang === 'en' ? 'Type' : 'Tipo'}</dt>
                <dd>{category}</dd>
              </div>
            )
          }
        </dl>
        {summary && <p class="pd-summary">{summary}</p>}
      </div>
      <HeroMedia media={media} />
    </header>

    <!-- Nivel 2: cuerpo flexible — Portable Text con patrones de bloque de media -->
    <section class="pd-body">
      <BodyBlocks blocks={body} />
    </section>

    <!-- Pie: stack completo, link externo -->
    <footer class="pd-footer" data-reveal>
      {
        project.stack && project.stack.length > 0 && (
          <p class="pd-stack">
            <span class="pd-stack-label">Stack</span>
            {project.stack.join(' · ')}
          </p>
        )
      }
      {
        project.externalUrl && (
          <a class="pd-external" href={project.externalUrl} target="_blank" rel="noopener noreferrer">
            {dict.external_link} ↗
          </a>
        )
      }
      {
        service && (
          <p class="pd-service">
            {dict.expertise_case_of}{' '}
            <a href={`${pathFor('especialidades', lang)}${service.slug.current}/`}>{t(service.title, lang)}</a>
          </p>
        )
      }
    </footer>
  </article>

  {project.nextProject && <NextProject lang={lang} next={project.nextProject} />}
</Base>

<script>
  import {initChameleonTint} from '../lib/chameleon'

  // Patrón camaleón suave (A3) en página larga: el fondo gana un tinte
  // sutil del acento de proyectos a lo largo del recorrido.
  initChameleonTint('#5b8cff')

  // Progreso del caso: proporción recorrida del artículo, pintada 1:1 con el
  // scroll (posición, no animación — funciona igual con reduced-motion).
  const bar = document.querySelector<HTMLElement>('[data-case-progress]')
  const article = document.querySelector<HTMLElement>('.project-detail')
  if (bar && article) {
    const update = (): void => {
      const rect = article.getBoundingClientRect()
      const total = rect.height - window.innerHeight
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1
      bar.style.transform = `scaleX(${progress})`
    }
    window.addEventListener('scroll', update, {passive: true})
    window.addEventListener('resize', update)
    update()
  }
</script>

<style>
  .case-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: 50;
    pointer-events: none;
  }

  .project-detail {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 90rem;
    margin-inline: auto;
  }

  .pd-breadcrumb {
    margin: 0 0 1.5rem;
  }
  .pd-breadcrumb a {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .pd-breadcrumb a:hover {
    color: var(--accent);
  }

  .pd-hero {
    display: grid;
    gap: clamp(2rem, 6vh, 4rem);
    margin-bottom: clamp(3rem, 10vh, 6rem);
  }

  .pd-heading h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(2.75rem, 8vw, 7rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin: 0 0 1.5rem;
    max-width: 14ch;
  }

  .pd-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1.5rem;
  }
  .pd-meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
  .pd-meta dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
  }

  .pd-summary {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 52ch;
    margin: 0;
  }

  .pd-body {
    margin-bottom: clamp(3rem, 10vh, 6rem);
  }

  .pd-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 20%, transparent);
    padding-top: 2rem;
  }
  .pd-stack {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    margin: 0;
    max-width: 60ch;
  }
  .pd-stack-label {
    color: var(--accent);
    margin-right: 1rem;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .pd-external {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--transition-fast);
  }
  .pd-external:hover {
    color: var(--accent);
  }
  .pd-service {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    margin: 0;
    width: 100%;
  }
  .pd-service a {
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    text-decoration: none;
    padding-bottom: 0.15em;
  }
  .pd-service a:hover {
    color: var(--accent);
  }
</style>
