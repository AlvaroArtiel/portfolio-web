---
import Base from '../layouts/Base.astro'
import Card from '../components/projects/Card.astro'
import Filters from '../components/projects/Filters.astro'
import {ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import {getProjects} from '../lib/queries'

interface Props {
  lang: Lang
}
const {lang} = Astro.props

const projects = await getProjects()
const heading = ui[lang].nav_projects

// Segunda voz tipográfica (sesión 3): recuento real derivado de los datos.
const categoryCount = new Set(projects.map((p) => p.category).filter(Boolean)).size
const countLine =
  lang === 'en'
    ? `${projects.length} projects · ${categoryCount} categories`
    : `${projects.length} proyectos · ${categoryCount} categorías`
const description =
  lang === 'en'
    ? 'Selected projects by Álvaro Artiel: own products, client work, training and personal experiments.'
    : 'Proyectos de Álvaro Artiel: producto propio, trabajo de cliente, formación y experimentos personales.'
---

<Base title={`${heading} — Álvaro Artiel`} description={description} lang={lang} section="projects">
  <section class="projects-page">
    <header class="projects-header" data-reveal>
      <h1>{heading}</h1>
      <p class="page-count">{countLine}</p>
      <Filters lang={lang} />
    </header>

    <!-- Deck estático: F3 lo apila con scroll -->
    <div class="projects-list" data-deck>
      {projects.map((project, index) => <Card lang={lang} project={project} index={index} total={projects.length} />)}
    </div>
  </section>
</Base>

<script>
  import {initDeck} from '../components/projects/Deck'
  initDeck()
</script>

<style>
  .projects-page {
    /* Mínimo 7rem (B10): despeja la franja del header fijo (~80px) incluso
       en pantallas móviles bajas donde el término en vh del clamp caería
       por debajo de esa altura. */
    padding: clamp(7rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
  }

  .projects-header h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }

  /* Segunda voz: recuento mono muted bajo el titular */
  .page-count {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0 0 clamp(1.5rem, 4vh, 2.5rem);
  }

  /* Cartas al ancho de contenido de la sección (el padding lateral marca los
     márgenes), como el deck de la home: el tope de 74rem las dejaba más
     estrechas que el resto de páginas. El encabezado acompaña a las cartas. */
  .projects-list {
    display: grid;
    gap: clamp(2rem, 5vh, 3rem);
    width: 100%;
  }

  .projects-header {
    width: 100%;
  }

  /* Apilado del deck: cada tarjeta se pega al mismo offset y la siguiente
     la cubre — con la franja de identidad al top (B5), la entrante anuncia
     su proyecto y la tapada muere mostrando el suyo. Con 10 cartas, las
     pestañas acumuladas del patrón fichero no caben en un viewport: esa
     variante vive en el deck de la home (4 cartas). Solo desktop: en móvil
     el scroll es nativo sin pin. */
  @media (min-width: 721px) {
    .projects-list :global(.project-card) {
      position: sticky;
      top: clamp(4.5rem, 12vh, 7rem);
    }
  }
</style>
