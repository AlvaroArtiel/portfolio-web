---
import Base from '../layouts/Base.astro'
import BodyBlocks from '../components/projects/BodyBlocks.astro'
import {t, ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import type {BlogPost, BodyBlock} from '../lib/queries'
import {getPosts} from '../lib/queries'
import {urlFor} from '../lib/sanity'
import {pathFor} from '../lib/routes'
import {readingTime} from '../lib/reading-time'

interface Props {
  lang: Lang
  post: BlogPost
}
const {lang, post} = Astro.props
const dict = ui[lang]

const title = t(post.title, lang)
const excerpt = t(post.excerpt, lang)
const body = (post.body?.[lang] ?? post.body?.es ?? []) as BodyBlock[]
const minutes = readingTime(body as unknown[])

const ogImage = post.cover ? urlFor(post.cover, {w: 1200, h: 630}).url() : undefined

// "Siguiente entrada": la siguiente más antigua; si no existe, estado con voz.
const posts = await getPosts()
const index = posts.findIndex((p) => p.slug.current === post.slug.current)
const next = index >= 0 ? posts[index + 1] : undefined

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
})

function formatDate(date?: string): string {
  if (!date) return ''
  const parsed = new Date(date)
  if (Number.isNaN(parsed.getTime())) return date
  return dateFormatter.format(parsed)
}
---

<Base title={`${title} — Álvaro Artiel`} description={excerpt || title} lang={lang} section="blog" ogImage={ogImage}>
  {/* Barra de progreso de lectura (sesión 3 §3.4) */}
  <div class="read-progress" data-read-progress aria-hidden="true"></div>

  <article class="blog-post">
    <header class="bp-header" data-reveal>
      <p class="bp-breadcrumb">
        <a href={pathFor('blog', lang)}>← {dict.back_to_blog}</a>
      </p>
      <p class="bp-date">
        {formatDate(post.date)} <span class="bp-read">· {dict.blog_read} · {minutes} {dict.blog_min}</span>
      </p>
      <h1>{title}</h1>
      {
        post.tags && post.tags.length > 0 && (
          <p class="tag-chips">
            {post.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </p>
        )
      }
      {
        post.cover && (
          <img
            class="bp-cover"
            src={urlFor(post.cover, {w: 1600}).url()}
            alt=""
            width="1600"
            loading="eager"
          />
        )
      }
    </header>

    <section class="bp-body">
      <BodyBlocks blocks={body} />
    </section>

    {/* -------- Autor al pie -------- */}
    <aside class="bp-author">
      <img class="bp-author-portrait" src="/retrato.png" alt="Álvaro Artiel" width="120" height="120" loading="lazy" />
      <div>
        <p class="bp-author-name">Álvaro Artiel</p>
        <p class="bp-author-line">{dict.blog_author_line}</p>
        <a class="bp-author-cta" href={pathFor('contacto', lang)}>{dict.blog_author_cta}</a>
      </div>
    </aside>

    {/* -------- Siguiente entrada (o estado con voz) -------- */}
    <footer class="bp-next">
      {
        next ? (
          <a class="bp-next-link" href={`${pathFor('blog', lang)}${next.slug.current}/`}>
            <span class="bp-next-kicker">{dict.blog_next}</span>
            <span class="bp-next-title">{t(next.title, lang)}</span>
          </a>
        ) : (
          <a class="bp-next-link" href={pathFor('proyectos', lang)}>
            <span class="bp-next-kicker">{dict.blog_next_empty}</span>
            <span class="bp-next-title">{dict.blog_next_empty_cta}</span>
          </a>
        )
      }
    </footer>
  </article>
</Base>

<script>
  // Progreso de lectura: proporción de artículo recorrido, pintada 1:1 con el
  // scroll (posición, no animación — funciona igual con reduced-motion).
  const bar = document.querySelector<HTMLElement>('[data-read-progress]')
  const article = document.querySelector<HTMLElement>('.blog-post')
  if (bar && article) {
    const update = (): void => {
      const rect = article.getBoundingClientRect()
      const total = rect.height - window.innerHeight
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1
      bar.style.transform = `scaleX(${progress})`
    }
    window.addEventListener('scroll', update, {passive: true})
    window.addEventListener('resize', update)
    update()
  }
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: 50;
    pointer-events: none;
  }

  .blog-post {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 68ch;
    margin-inline: auto;
  }

  .bp-breadcrumb {
    margin: 0 0 1.5rem;
  }
  .bp-breadcrumb a {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out-token);
  }
  .bp-breadcrumb a:hover {
    color: var(--accent);
  }

  .bp-date {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .bp-read {
    color: var(--text-muted);
  }

  .bp-header h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
    padding: 0.2em 0.75em;
  }

  .bp-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    margin: 2rem 0 0;
  }

  .bp-header {
    margin-bottom: clamp(2.5rem, 7vh, 4rem);
  }

  .bp-body {
    margin-bottom: clamp(3rem, 8vh, 5rem);
  }

  /* Pull-quotes display: las citas del Portable Text son momentos, no párrafos */
  .bp-body :global(blockquote) {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
    border-left: 3px solid var(--accent);
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
  }

  /* Imágenes del cuerpo: full-bleed dentro del techo editorial */
  .bp-body :global(img) {
    display: block;
    width: min(100vw - 2 * clamp(1.5rem, 6vw, 4rem), 72rem);
    max-width: none;
    margin-inline: calc(50% - min(100vw - 2 * clamp(1.5rem, 6vw, 4rem), 72rem) / 2);
    border-radius: 4px;
  }

  /* -------- Autor -------- */
  .bp-author {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    background: var(--surface-1);
    border: var(--border-soft);
    border-radius: 10px;
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .bp-author-portrait {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1);
  }
  .bp-author-name {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
  }
  .bp-author-line {
    font-size: var(--step-small);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }
  .bp-author-cta {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* -------- Siguiente entrada -------- */
  .bp-next {
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 20%, transparent);
    padding-top: 2rem;
  }
  .bp-next-link {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
  }
  .bp-next-kicker {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
  }
  .bp-next-title {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    letter-spacing: -0.02em;
    transition: color var(--dur-micro) var(--ease-out-token);
  }
  .bp-next-link:hover .bp-next-title {
    color: var(--accent);
  }
</style>
