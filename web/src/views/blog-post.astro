---
import Base from '../layouts/Base.astro'
import BodyBlocks from '../components/projects/BodyBlocks.astro'
import {t, ui} from '../lib/i18n'
import type {Lang} from '../lib/i18n'
import type {BlogPost, BodyBlock} from '../lib/queries'
import {urlFor} from '../lib/sanity'
import {pathFor} from '../lib/routes'

interface Props {
  lang: Lang
  post: BlogPost
}
const {lang, post} = Astro.props
const dict = ui[lang]

const title = t(post.title, lang)
const excerpt = t(post.excerpt, lang)
const body = (post.body?.[lang] ?? post.body?.es ?? []) as BodyBlock[]

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
})

function formatDate(date?: string): string {
  if (!date) return ''
  const parsed = new Date(date)
  if (Number.isNaN(parsed.getTime())) return date
  return dateFormatter.format(parsed)
}
---

<Base title={`${title} — Álvaro Artiel`} description={excerpt || title} lang={lang} section="blog">
  <article class="blog-post">
    <header class="bp-header" data-reveal>
      <p class="bp-breadcrumb">
        <a href={pathFor('blog', lang)}>← {dict.back_to_blog}</a>
      </p>
      <p class="bp-date">{formatDate(post.date)}</p>
      <h1>{title}</h1>
      {
        post.tags && post.tags.length > 0 && (
          <p class="bp-tags">{post.tags.join(' · ')}</p>
        )
      }
      {
        post.cover && (
          <img
            class="bp-cover"
            src={urlFor(post.cover, {w: 1600}).url()}
            alt=""
            width="1600"
            loading="eager"
          />
        )
      }
    </header>

    <section class="bp-body">
      <BodyBlocks blocks={body} />
    </section>

    <footer class="bp-footer">
      <a class="bp-back" href={pathFor('blog', lang)}>← {dict.back_to_blog}</a>
    </footer>
  </article>
</Base>

<style>
  .blog-post {
    padding: clamp(6rem, 16vh, 9rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vh, 5rem);
    max-width: 68ch;
    margin-inline: auto;
  }

  .bp-breadcrumb {
    margin: 0 0 1.5rem;
  }
  .bp-breadcrumb a {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .bp-breadcrumb a:hover {
    color: var(--accent);
  }

  .bp-date {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .bp-header h1 {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .bp-tags {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    margin: 0 0 2rem;
  }

  .bp-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    margin: 2rem 0 0;
  }

  .bp-header {
    margin-bottom: clamp(2.5rem, 7vh, 4rem);
  }

  .bp-body {
    margin-bottom: clamp(3rem, 8vh, 5rem);
  }

  .bp-footer {
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 20%, transparent);
    padding-top: 2rem;
  }
  .bp-back {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--transition-fast);
  }
  .bp-back:hover {
    color: var(--accent);
  }
</style>
