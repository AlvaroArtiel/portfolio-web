---
import type {SanityImageRef} from '../../lib/queries'
import {urlFor} from '../../lib/sanity'

interface Props {
  media: SanityImageRef[]
}
const {media} = Astro.props
const [first, second, third] = media
---

<!--
  Composición editorial asimétrica de las 2-3 heroMedia: cada slot tiene
  posición y tamaño propios (no es una galería). En F4 se convierten en lonas.
-->
<div class={`hero-media count-${media.length}`} data-curtain-media id="hero-media">
  {
    first && (
      <figure class="hm-slot hm-a">
        <img crossorigin="anonymous" src={urlFor(first, {w: 1600}).url()} alt="" width="1600" height="1000" loading="eager" />
      </figure>
    )
  }
  {
    second && (
      <figure class="hm-slot hm-b">
        <img crossorigin="anonymous" src={urlFor(second, {w: 900}).url()} alt="" width="900" height="563" loading="lazy" />
      </figure>
    )
  }
  {
    third && (
      <figure class="hm-slot hm-c">
        <img crossorigin="anonymous" src={urlFor(third, {w: 720}).url()} alt="" width="720" height="450" loading="lazy" />
      </figure>
    )
  }
</div>

<script>
  import {mountScene} from '../../lib/three-island'

  const container = document.querySelector<HTMLElement>('[data-curtain-media]')
  if (container) {
    void mountScene(container, () => import('../../scenes/curtain-media').then((m) => m.default))
  }
</script>

<style>
  .hero-media {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: start;
  }

  .hm-slot {
    margin: 0;
  }
  .hm-slot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  /* Slot A: protagonista, sangra hacia la derecha */
  .hm-a {
    grid-column: 3 / -1;
    grid-row: 1;
  }
  /* Slot B: contrapunto, solapa por la izquierda subiendo sobre A */
  .hm-b {
    grid-column: 1 / 6;
    grid-row: 1;
    margin-top: clamp(4rem, 14vw, 12rem);
    z-index: 1;
    box-shadow: 12px -12px 0 0 var(--bg);
  }
  /* Slot C: nota pequeña descolgada a la derecha */
  .hm-c {
    grid-column: 8 / 12;
    margin-top: clamp(-2rem, -3vw, -1rem);
  }

  .count-2 .hm-a {
    grid-column: 2 / -1;
  }

  @media (max-width: 720px) {
    .hm-a,
    .hm-b,
    .hm-c,
    .count-2 .hm-a {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
      box-shadow: none;
    }
    .hm-b {
      width: 78%;
      margin-top: -3rem;
      margin-left: 0;
    }
    .hm-c {
      width: 62%;
      margin-left: auto;
      margin-top: -2rem;
    }
  }
</style>
