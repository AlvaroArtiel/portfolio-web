---
import type {Lang} from '../../lib/i18n'
import {ui} from '../../lib/i18n'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const filters: {value: string; es: string; en: string}[] = [
  {value: 'propio', es: 'Producto propio', en: 'Own product'},
  {value: 'cliente', es: 'Cliente', en: 'Client'},
  {value: 'formacion', es: 'Formación', en: 'Training'},
  {value: 'personal', es: 'Personal', en: 'Personal'},
]
---

<!-- Filtros como enlaces: sin JS navegan con ?cat=; el script filtra en el cliente -->
<nav class="filters" aria-label={lang === 'en' ? 'Filter projects' : 'Filtrar proyectos'} data-filters>
  <a href="?" data-cat="" aria-current="true" data-cursor-label={dict.all_categories}>{dict.all_categories}</a>
  {
    filters.map((filter) => (
      <a href={`?cat=${filter.value}`} data-cat={filter.value} data-cursor-label={filter[lang]}>
        {filter[lang]}
      </a>
    ))
  }
</nav>

<p class="sr-only" data-filter-status aria-live="polite"></p>

<script>
  // Filtrado progresivo: lee ?cat=, oculta tarjetas no coincidentes y evita recargas.
  function updateCurrent(cat: string): void {
    document.querySelectorAll<HTMLAnchorElement>('[data-filters] a').forEach((link) => {
      if ((link.dataset.cat ?? '') === cat) link.setAttribute('aria-current', 'true')
      else link.removeAttribute('aria-current')
    })
  }

  function announceCount(): void {
    const visible = document.querySelectorAll('[data-category]:not([hidden])').length
    const status = document.querySelector<HTMLElement>('[data-filter-status]')
    const isEn = document.documentElement.lang === 'en'
    if (status) status.textContent = isEn ? `${visible} projects shown` : `${visible} proyectos mostrados`
  }

  function applyFilter(cat: string): void {
    document.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
      card.hidden = cat !== '' && card.dataset.category !== cat
    })
    updateCurrent(cat)
    announceCount()
  }

  function currentCat(): string {
    return new URLSearchParams(location.search).get('cat') ?? ''
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-filters] a').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault()
      const cat = link.dataset.cat ?? ''
      const url = cat ? `?cat=${cat}` : location.pathname
      history.replaceState(null, '', url)
      // El deck animado (Deck.ts) puede reclamar el filtrado con preventDefault;
      // si nadie lo reclama, corte directo.
      const claimed = !document.dispatchEvent(new CustomEvent('deck:filter', {detail: {cat}, cancelable: true}))
      if (!claimed) applyFilter(cat)
      else {
        updateCurrent(cat)
        // Deck.ts anima la salida/entrada de cartas (~0.75s); espera a que
        // termine para que el recuento anunciado refleje el estado final.
        setTimeout(announceCount, 800)
      }
    })
  })

  applyFilter(currentCat())
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  .filters a {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text-muted);
    text-decoration: none;
    padding-bottom: 0.2em;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .filters a:hover {
    color: var(--text);
  }
  .filters a[aria-current='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
