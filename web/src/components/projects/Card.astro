---
import type {Lang} from '../../lib/i18n'
import {t} from '../../lib/i18n'
import type {Project} from '../../lib/queries'
import {urlFor} from '../../lib/sanity'

interface Props {
  lang: Lang
  project: Project
  index: number
  /** Total de cartas del listado, para el índice "01/04" de la pestaña. */
  total?: number
}
const {lang, project, index, total} = Astro.props
const indexLabel = total ? `${String(index + 1).padStart(2, '0')}/${String(total).padStart(2, '0')}` : null

const href = lang === 'en' ? `/en/projects/${project.slug.current}/` : `/proyectos/${project.slug.current}/`

const categoryLabels: Record<string, {es: string; en: string}> = {
  propio: {es: 'Producto propio', en: 'Own product'},
  cliente: {es: 'Cliente', en: 'Client'},
  formacion: {es: 'Formación', en: 'Training'},
  personal: {es: 'Personal', en: 'Personal'},
}
const category = project.category ? categoryLabels[project.category]?.[lang] : undefined
---

<!-- Carta del deck (remediación B5): la identidad vive en una franja superior
     de ~72px — cuando la carta siguiente cubre a esta, lo primero que asoma
     de la entrante (y lo último visible de la tapada) es su identidad. -->
<article class="project-card" style={`--card-index: ${index}`} data-category={project.category} data-deck-card>
  <a href={href} data-cursor="view">
    <div class="pc-tab">
      <h2 class="pc-title">{t(project.title, lang)}</h2>
      <p class="pc-meta">
        {indexLabel && <span class="pc-index">{indexLabel}</span>}
        <span>{project.year}</span>
        {category && <span>{category}</span>}
      </p>
    </div>
    <div class="pc-media">
      {
        project.cover && (
          <img
            src={urlFor(project.cover, {w: 1600, h: 900}).url()}
            alt=""
            width="1600"
            height="900"
            loading={index < 2 ? 'eager' : 'lazy'}
          />
        )
      }
    </div>
    <div class="pc-body">
      <p class="pc-summary">{t(project.summary, lang)}</p>
      {project.stack && <p class="pc-stack">{project.stack.slice(0, 4).join(' · ')}</p>}
    </div>
  </a>
</article>

<script>
  // Tilt sutil al hover (sesión 3 §3.7-11a): rotateX/Y ≤3.5° siguiendo al
  // cursor. Solo puntero fino y sin reduced-motion; el resto de estados de
  // hover (zoom, elevación) son CSS y no dependen de esto.
  if (
    window.matchMedia('(pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    document.querySelectorAll<HTMLAnchorElement>('[data-deck-card] > a').forEach((card) => {
      card.style.transformStyle = 'preserve-3d'
      card.addEventListener(
        'pointermove',
        (e) => {
          const rect = card.getBoundingClientRect()
          const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -7
          const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 7
          card.style.transform = `perspective(1100px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`
        },
        {passive: true},
      )
      card.addEventListener('pointerleave', () => {
        card.style.transition = 'transform var(--dur-element) var(--ease-out-token)'
        card.style.transform = 'perspective(1100px) rotateX(0deg) rotateY(0deg)'
        window.setTimeout(() => (card.style.transition = ''), 520)
      })
    })
  }
</script>

<style>
  .project-card a {
    display: block;
    text-decoration: none;
    color: var(--text);
    /* Elevación (A5): la carta existe como objeto sobre el fondo */
    background: var(--surface-1);
    border: var(--border-soft);
    border-radius: 4px;
    overflow: hidden;
    outline: 1px solid transparent;
    transition: outline-color var(--transition-fast);
  }
  .project-card a:hover {
    outline-color: var(--accent);
    /* Estado activo: sube un nivel de elevación */
    background: var(--surface-2);
    box-shadow: var(--shadow-2);
  }

  /* Franja de identidad: 72px fijos, siempre lo primero/último visible */
  .pc-tab {
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: clamp(1.25rem, 3vw, 2rem);
    border-bottom: var(--border-soft);
  }

  .pc-title {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project-card a:hover .pc-title {
    color: var(--accent);
  }

  .pc-index {
    color: var(--accent);
  }

  .pc-meta {
    display: flex;
    flex-shrink: 0;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
  }

  .pc-media {
    overflow: hidden;
  }

  .pc-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    transition: transform var(--dur-element) var(--ease-out-token);
  }

  /* En el deck de escritorio las cartas se fijan (sticky) al top: la carta
     entera debe caber en el viewport o la descripción (abajo) queda fuera de
     cuadro y no se lee. A ancho completo el 21/9 se dispara en alto, así que se
     le pone tope dejando sitio al offset del sticky, la pestaña y el cuerpo.
     object-fit:cover recorta sin deformar. */
  @media (min-width: 721px) {
    .pc-media img {
      max-height: calc(100dvh - 22rem);
    }
  }

  .project-card a:hover .pc-media img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-media img {
      transition: none;
    }
    .project-card a:hover .pc-media img {
      transform: none;
    }
  }

  .pc-body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.25rem, 3vw, 2rem);
  }

  .pc-summary {
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
    max-width: 58ch;
  }

  .pc-stack {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .pc-tab {
      height: auto;
      min-height: 3.5rem;
      flex-wrap: wrap;
      padding-block: 0.75rem;
      gap: 0.25rem 1rem;
    }
    .pc-title {
      white-space: normal;
    }
    .pc-media img {
      aspect-ratio: 16 / 9;
    }
    .pc-body {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
