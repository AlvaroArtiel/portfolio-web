---
import type {Lang} from '../lib/i18n'
import {ui} from '../lib/i18n'
import {pathFor, routeMap} from '../lib/routes'
import LangSwitch from './LangSwitch.astro'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]

const items: {key: string; label: string}[] = [
  {key: 'proyectos', label: dict.nav_projects},
  {key: 'experiencia', label: dict.nav_experience},
  {key: 'personal', label: dict.nav_personal},
  {key: 'blog', label: dict.nav_blog},
  {key: 'cv', label: dict.nav_cv},
  {key: 'contacto', label: dict.nav_contact},
]

const slugLabel = (key: string) => (lang === 'en' ? `/en/${routeMap[key] ?? key}` : `/${key}`)
---

<div id="menu-overlay" class="menu-overlay" hidden>
  <!-- Canvas del snake-trail (se activa en F3) -->
  <canvas id="menu-trail" aria-hidden="true"></canvas>

  <nav class="menu-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a class="menu-item" href={pathFor(item.key, lang)}>
              <span class="menu-item-slug" aria-hidden="true">{slugLabel(item.key)}</span>
              <span class="menu-item-label" data-text={item.label}>
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu-meta">
    <LangSwitch lang={lang} />
  </div>
</div>

<script>
  import {initMenuOverlay} from './MenuOverlay.ts'
  initMenuOverlay()
</script>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 350ms var(--ease-standard),
      visibility 0s linear 350ms;
  }
  :global(html[data-menu-open]) .menu-overlay {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 350ms var(--ease-standard),
      visibility 0s;
  }

  #menu-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .menu-nav {
    position: relative;
    padding-inline: clamp(1.5rem, 8vw, 6rem);
  }
  .menu-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-nav li + li {
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 25%, transparent);
  }

  .menu-item {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: clamp(0.35rem, 1.2vh, 0.75rem);
    text-decoration: none;
    transform: translateX(0);
    transition: transform 300ms var(--ease-standard);
  }
  .menu-item:hover,
  .menu-item:focus-visible {
    transform: translateX(0.35em);
  }

  .menu-item-slug {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    min-width: 7.5ch;
  }

  /* Titular gigante: contorno que se rellena de acento con un barrido izquierda→derecha */
  .menu-item-label {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(2.25rem, min(8.5vh, 10.5vw), 6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    background-image: linear-gradient(to right, var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    transition:
      background-size 420ms var(--ease-standard),
      color 200ms var(--ease-standard) 80ms;
  }
  .menu-item:hover .menu-item-label,
  .menu-item:focus-visible .menu-item-label {
    color: transparent;
    background-size: 100% 100%;
  }

  .menu-meta {
    position: relative;
    padding-inline: clamp(1.5rem, 8vw, 6rem);
    padding-block-start: clamp(1rem, 4vh, 2rem);
  }

  @media (max-width: 640px) {
    .menu-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .menu-item-slug {
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-item:hover .menu-item-label,
    .menu-item:focus-visible .menu-item-label {
      color: var(--accent);
      background: none;
    }
  }
</style>
