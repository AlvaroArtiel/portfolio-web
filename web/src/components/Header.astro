---
import type {Lang} from '../lib/i18n'
import {pathFor} from '../lib/routes'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const homeHref = pathFor('', lang)
---

<header class="site-header">
  <a class="monogram" href={homeHref} aria-label={lang === 'en' ? 'Home — Álvaro Artiel' : 'Inicio — Álvaro Artiel'}>
    <!-- Marca definitiva: misma silueta que el monograma 3D (scenes/monogram.ts,
         constantes A_OUTLINE/A_BAR mapeadas con sx = 50 + x·80, sy = 50 − y·80).
         En la home, el 3D vive en el primer viewport y este SVG toma el relevo
         al acoplarse; en el resto de páginas es la única marca. -->
    <span id="monogram-slot" aria-hidden="true">
      <svg viewBox="0 0 148 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g class="monogram-back" transform="translate(54 4.6) scale(0.92)">
          <path d="M6 90 L50 6 L94 90 H74 L50 42 L26 90 Z M29.2 59.6 H70.8 V69.2 H29.2 Z" />
        </g>
        <g class="monogram-front">
          <path d="M6 90 L50 6 L94 90 H74 L50 42 L26 90 Z M29.2 59.6 H70.8 V69.2 H29.2 Z" />
        </g>
      </svg>
    </span>
  </a>

  <!-- Sin JS este botón es un ancla al nav del footer; el script lo promociona a toggle del overlay -->
  <a
    id="menu-toggle"
    class="menu-toggle"
    href="#footer-nav"
    role="button"
    aria-expanded="false"
    aria-controls="menu-overlay"
    aria-label={lang === 'en' ? 'Menu' : 'Menú'}
  >
    <span class="menu-toggle-line" aria-hidden="true"></span>
    <span class="menu-toggle-line" aria-hidden="true"></span>
  </a>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    /* El header vive sobre el contenido sin fondo: cada pieza lleva el suyo */
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }

  .monogram {
    display: block;
    line-height: 0;
  }
  #monogram-slot {
    display: block;
    transition: opacity var(--transition-base);
  }
  #monogram-slot svg {
    height: 26px;
    width: auto;
    display: block;
  }
  .monogram-back path {
    fill: var(--accent);
  }
  .monogram-front path {
    fill: var(--text);
  }

  .menu-toggle {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    /* Elevación (A5): control flotante, un nivel por encima de las cartas */
    background: var(--surface-2);
    border: var(--border-soft);
    transition: background var(--transition-fast);
  }
  .menu-toggle-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text);
    transition:
      transform var(--transition-base),
      background var(--transition-fast);
  }
  .menu-toggle:hover {
    background: var(--accent);
  }
  .menu-toggle:hover .menu-toggle-line {
    background: var(--bg);
  }
  /* Estado abierto (lo aplica el script en <html data-menu-open>) */
  :global(html[data-menu-open]) .menu-toggle-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  :global(html[data-menu-open]) .menu-toggle-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>
