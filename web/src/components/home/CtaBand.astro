---
import type {Lang} from '../../lib/i18n'
import {ui} from '../../lib/i18n'
import {pathFor} from '../../lib/routes'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const dict = ui[lang]
---

<section class="cta-band" data-reveal id="cta-band">
  <!-- Tipografía líquida WebGL encima; el link real queda siempre debajo y recibe el clic -->
  <a class="cta-link" href={pathFor('contacto', lang)} id="cta-liquid-target">
    {dict.work_together}
  </a>
</section>

<script>
  import {mountScene} from '../../lib/three-island'

  const band = document.getElementById('cta-band')
  const link = document.getElementById('cta-liquid-target')
  if (band && link) {
    void mountScene(band, () => import('../../scenes/liquid-text').then((m) => m.default)).then((unmount) => {
      if (unmount) link.classList.add('is-covered')
    })
  }
</script>

<style>
  .cta-band {
    padding: var(--space-s) clamp(1.5rem, 6vw, 4rem);
    text-align: center;
  }

  .cta-link {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: clamp(2.5rem, 7.5vw, 7rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .cta-link:hover {
    color: var(--accent);
  }

  /* El canvas del efecto no roba el clic del link */
  .cta-band :global(canvas) {
    pointer-events: none;
  }
  .cta-link.is-covered {
    color: transparent;
  }
  .cta-link.is-covered:focus-visible {
    color: var(--text);
  }
</style>
