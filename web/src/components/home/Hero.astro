---
import type {Lang} from '../../lib/i18n'
import {t, ui} from '../../lib/i18n'
import type {SiteSettings} from '../../lib/queries'

interface Props {
  lang: Lang
  settings: SiteSettings | null
}
const {lang, settings} = Astro.props
const dict = ui[lang]

const title =
  t(settings?.heroTitle, lang) || (lang === 'en' ? 'I design digital products end to end' : 'Diseño productos digitales de punta a punta')
const subtitle = t(settings?.heroSubtitle, lang) || 'diseño · código · producto'
---

<section class="hero" data-reveal>
  <p class="hero-eyebrow">Álvaro Artiel</p>
  <!-- El h1 real siempre existe: las partículas solo lo cubren visualmente -->
  <div class="hero-stage" id="hero-stage">
    <h1 class="hero-title" id="hero-title">{title}<span class="hero-dot" aria-hidden="true">.</span></h1>
  </div>
  <p class="hero-subtitle">{subtitle}</p>
  <p class="hero-scroll-hint" aria-hidden="true">{dict.scroll_hint} ↓</p>
  <button class="hero-skip" id="hero-skip" type="button" hidden>
    {lang === 'en' ? 'Skip effect' : 'Saltar efecto'}
  </button>
</section>

<script>
  import {mountScene} from '../../lib/three-island'

  const stage = document.getElementById('hero-stage')
  const titleEl = document.getElementById('hero-title')
  const skip = document.getElementById('hero-skip') as HTMLButtonElement | null

  if (stage && titleEl && skip) {
    void mountScene(stage, () => import('../../scenes/hero-particles').then((m) => m.default), {eager: true}).then(
      (unmount) => {
        if (!unmount) return // sin WebGL/reduced-motion: titular HTML tal cual
        titleEl.classList.add('is-covered')
        skip.hidden = false
        skip.addEventListener('click', () => {
          unmount()
          titleEl.classList.remove('is-covered')
          skip.hidden = true
        })
      },
    )

    // Capa fija para el monograma 3D que viaja del hero al header
    const layer = document.createElement('div')
    layer.id = 'monogram-layer'
    layer.style.cssText = 'position:fixed;inset:0;z-index:101;pointer-events:none;'
    document.body.appendChild(layer)
    void mountScene(layer, () => import('../../scenes/monogram').then((m) => m.default), {eager: true}).then(
      (unmount) => {
        if (!unmount) layer.remove()
      },
    )
  }
</script>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(5rem, 12vh, 8rem) clamp(1.5rem, 6vw, 4rem) clamp(2rem, 6vh, 4rem);
    position: relative;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  .hero-stage {
    position: relative;
    min-height: 42vh;
    display: flex;
    align-items: center;
  }

  /* Mientras las partículas están activas, el titular real queda cubierto
     (sigue en el DOM para SEO/lectores; "saltar efecto" lo restaura). */
  .hero-title.is-covered {
    visibility: hidden;
  }

  .hero-skip {
    position: absolute;
    bottom: clamp(1rem, 4vh, 2.5rem);
    left: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 1px solid var(--text-muted);
    padding: 0 0 0.15em;
    cursor: pointer;
  }
  .hero-skip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 12ch;
    margin: 0;
    text-wrap: balance;
  }
  .hero-dot {
    color: var(--accent);
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    color: var(--text-muted);
    margin: 2rem 0 0;
    letter-spacing: 0.04em;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: clamp(1rem, 4vh, 2.5rem);
    right: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
  }
</style>
