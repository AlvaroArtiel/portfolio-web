---
import type {Lang} from '../../lib/i18n'
import {t, ui} from '../../lib/i18n'
import type {SiteSettings} from '../../lib/queries'

interface Props {
  lang: Lang
  settings: SiteSettings | null
}
const {lang, settings} = Astro.props
const dict = ui[lang]

const title =
  t(settings?.heroTitle, lang) || (lang === 'en' ? 'I design digital products end to end' : 'Diseño productos digitales de punta a punta')
const subtitle = t(settings?.heroSubtitle, lang) || 'diseño · código · producto'
---

<!-- Composición (remediación A2/B2): el titular es la masa dominante centrada
     (~80% de ancho, formado por las partículas); nombre y keywords enmarcan
     el perímetro (arriba-izq / abajo-izq); el monograma 3D entra arriba-dcha
     en diagonal compositiva con el titular (scenes/monogram.ts). -->
<section class="hero" data-reveal>
  <p class="hero-eyebrow">
    <span class="hero-name" tabindex="0">Álvaro Artiel</span>
    <span class="hero-portrait" aria-hidden="true">
      <img src="/retrato.png" alt="" width="180" height="180" loading="eager" />
    </span>
  </p>
  <!-- El h1 real siempre existe: las partículas solo lo cubren visualmente -->
  <div class="hero-stage" id="hero-stage">
    <h1 class="hero-title" id="hero-title">{title}<span class="hero-dot" aria-hidden="true">.</span></h1>
  </div>
  <p class="hero-subtitle">{subtitle}</p>
  <p class="hero-scroll-hint" aria-hidden="true">{dict.scroll_hint} ↓</p>
  <button class="hero-skip" id="hero-skip" type="button" hidden>
    {lang === 'en' ? 'Skip effect' : 'Saltar efecto'}
  </button>
</section>

<script>
  import {mountScene} from '../../lib/three-island'
  import {initHeroFloaters} from '../../lib/hero-floaters'

  const hero = document.querySelector<HTMLElement>('.hero')
  if (hero) initHeroFloaters(hero)

  const stage = document.getElementById('hero-stage')
  const titleEl = document.getElementById('hero-title')
  const skip = document.getElementById('hero-skip') as HTMLButtonElement | null

  if (stage && titleEl && skip) {
    void mountScene(stage, () => import('../../scenes/hero-particles').then((m) => m.default), {eager: true}).then(
      (unmount) => {
        if (!unmount) return // sin WebGL/reduced-motion: titular HTML tal cual
        titleEl.classList.add('is-covered')
        skip.hidden = false
        skip.addEventListener('click', () => {
          unmount()
          titleEl.classList.remove('is-covered')
          skip.hidden = true
        })
      },
    )

    // Capa fija para el monograma 3D (vive SOLO en el primer viewport de la
    // home; scenes/monogram.ts la oculta al acoplarse al header)
    const layer = document.createElement('div')
    layer.id = 'monogram-layer'
    layer.style.cssText = 'position:fixed;inset:0;z-index:101;pointer-events:none;'
    document.body.appendChild(layer)
    void mountScene(layer, () => import('../../scenes/monogram').then((m) => m.default), {eager: true}).then(
      (unmount) => {
        if (!unmount) layer.remove()
      },
    )
  }
</script>

<style>
  .hero {
    min-height: 100svh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(5rem, 12vh, 8rem) clamp(1.5rem, 6vw, 4rem);
  }

  /* Masa dominante: ~80% del ancho, centrada ópticamente (ligeramente por
     encima del centro geométrico para compensar el marco inferior). */
  .hero-stage {
    position: relative;
    width: min(80vw, 70rem);
    min-height: 52vh;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-3vh);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 580;
    font-size: var(--step-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 14ch;
    margin: 0 auto;
    text-align: center;
    text-wrap: balance;
  }
  .hero-dot {
    color: var(--accent);
  }

  /* Mientras las partículas están activas, el titular real queda cubierto
     (sigue en el DOM para SEO/lectores; "saltar efecto" lo restaura). */
  .hero-title.is-covered {
    visibility: hidden;
  }

  /* Marco perimetral: nombre arriba-izq, keywords abajo-izq, hint abajo-dcha */
  .hero-eyebrow {
    position: absolute;
    top: clamp(4.5rem, 10vh, 6rem);
    left: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0;
    z-index: 2;
  }

  /* Retrato al hover del nombre (sesión 3 §3.5): humaniza el hero. En táctil
     aparece sutil al cargar; con reduced-motion, sin transición. */
  .hero-name {
    cursor: help;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent);
    padding-bottom: 0.15em;
  }
  .hero-portrait {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    width: 8.5rem;
    height: 8.5rem;
    clip-path: circle(0% at 30% 20%);
    transition: clip-path var(--dur-element, 500ms) var(--ease-out-token);
    pointer-events: none;
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
  .hero-eyebrow:hover .hero-portrait,
  .hero-eyebrow:focus-within .hero-portrait {
    clip-path: circle(75%);
  }
  @media (pointer: coarse) {
    .hero-portrait {
      width: 4rem;
      height: 4rem;
      clip-path: circle(75%);
      opacity: 0;
      animation: hero-portrait-in var(--dur-section, 900ms) var(--ease-out-token) 600ms forwards;
    }
  }
  @keyframes hero-portrait-in {
    to {
      opacity: 0.95;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-portrait {
      transition: none;
      animation: none;
    }
    @media (pointer: coarse) {
      .hero-portrait {
        opacity: 0.95;
      }
    }
  }

  /* -------- Objetos flotantes (capa del mundo de Álvaro) -------- */
  :global(.hero-floaters) {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  :global(.hero-floater) {
    position: absolute;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text);
    opacity: 0.85;
    pointer-events: auto;
  }
  :global(.hero-floater svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Idle flotante: loops ambientales lentos (no son tweens de entrada/trayecto,
     quedan fuera de DURATION por diseño — ver motion-tokens.ts). Solo cuando
     el módulo JS está vivo (puntero fino, sin reduced-motion). */
  :global(.hero-floaters.is-alive .fl-cursor svg) {
    animation: fl-bob 7s ease-in-out infinite;
  }
  :global(.hero-floaters.is-alive .fl-toggle svg) {
    animation: fl-bob 9s ease-in-out -2s infinite;
  }
  :global(.hero-floaters.is-alive .fl-puzzle svg) {
    animation: fl-bob-rot 8s ease-in-out -4s infinite;
  }
  :global(.hero-floaters.is-alive .fl-pick svg) {
    animation: fl-bob-rot 6.5s ease-in-out -1s infinite;
  }
  :global(.hero-floaters.is-alive .fl-note svg) {
    animation: fl-bob 7.5s ease-in-out -5s infinite;
  }
  @keyframes fl-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
  @keyframes fl-bob-rot {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-7px) rotate(5deg);
    }
  }

  /* Anclas: bandas perimetrales, jamás dentro de la caja del titular */
  :global(.fl-cursor) {
    top: 26%;
    left: 9%;
    width: 1.8rem;
    height: 1.8rem;
  }
  :global(.fl-toggle) {
    bottom: 30%;
    right: 5%;
    width: 3rem;
  }
  :global(.fl-puzzle) {
    bottom: 30%;
    left: 6.5%;
  }
  :global(.fl-pick) {
    top: 46%;
    right: 7%;
    width: 1.9rem;
  }
  :global(.fl-note) {
    top: 13%;
    left: 32%;
    width: 1.9rem;
  }

  .hero-subtitle {
    position: absolute;
    bottom: clamp(2.5rem, 7vh, 4.5rem);
    left: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin: 0;
    max-width: 46ch;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: clamp(2.5rem, 7vh, 4.5rem);
    right: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
  }

  .hero-skip {
    position: absolute;
    bottom: clamp(1rem, 3vh, 1.75rem);
    left: clamp(1.5rem, 6vw, 4rem);
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 1px solid var(--text-muted);
    padding: 0 0 0.15em;
    cursor: pointer;
  }
  .hero-skip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 720px) {
    .hero-stage {
      width: 100%;
      min-height: 46vh;
    }
    /* Menos piezas y más pequeñas: material del mundo, no ruido */
    :global(.fl-puzzle),
    :global(.fl-note) {
      display: none;
    }
    :global(.hero-floater) {
      width: 1.6rem !important;
      height: 1.6rem;
    }
    .hero-subtitle {
      right: clamp(1.5rem, 6vw, 4rem);
      bottom: clamp(4rem, 10vh, 6rem);
    }
    .hero-scroll-hint {
      bottom: clamp(1.25rem, 4vh, 2rem);
    }
    .hero-skip {
      bottom: clamp(1.25rem, 4vh, 2rem);
    }
  }
</style>
