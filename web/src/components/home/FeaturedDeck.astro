---
import type {Lang} from '../../lib/i18n'
import {t, ui} from '../../lib/i18n'
import type {Project} from '../../lib/queries'
import {urlFor} from '../../lib/sanity'
import {pathFor} from '../../lib/routes'
import SectionKicker from '../SectionKicker.astro'

interface Props {
  lang: Lang
  projects: Project[]
}
const {lang, projects} = Astro.props
const dict = ui[lang]

const projectHref = (slug: string) =>
  lang === 'en' ? `/en/projects/${slug}/` : `/proyectos/${slug}/`
---

<!-- Deck destacados (remediación B5/B6): fichero de cartas con pestañas —
     cada carta pega 72px más abajo que la anterior, de modo que al cubrirse
     queda visible su franja de identidad (patrón pxpush real; con 4 cartas
     las pestañas caben de sobra en el viewport). -->
<section class="featured" data-reveal>
  <SectionKicker index="02" label={dict.featured_projects} align="deck" />

  <ol class="deck" data-deck>
    {
      projects.map((project, index) => (
        <li class="card" style={`--card-index: ${index}`} data-deck-card>
          <a href={projectHref(project.slug.current)}>
            <div class="card-tab">
              <h3 class="card-title">{t(project.title, lang)}</h3>
              <p class="card-meta">
                <span>{project.year}</span>
                {project.stack && <span class="card-stack">{project.stack.slice(0, 3).join(' · ')}</span>}
              </p>
            </div>
            <div class="card-inner">
              <div class="card-media">
                {project.cover && (
                  <img
                    src={urlFor(project.cover, {w: 1280, h: 800}).url()}
                    alt=""
                    width="1280"
                    height="800"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
              <p class="card-summary">{t(project.summary, lang)}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ol>

  <a class="featured-cta" href={pathFor('proyectos', lang)}>{dict.view_all_projects} →</a>
</section>

<script>
  import {initDeck} from '../projects/Deck'
  initDeck()
</script>

<style>
  .featured {
    padding: var(--space-s) clamp(1.5rem, 6vw, 4rem);
  }

  /* Cartas a ~88% de ancho centradas (remediación B6) */
  .deck {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 5vh, 3rem);
    width: min(88%, 74rem);
  }

  /* Fichero con pestañas: cada carta pega 4.5rem (72px) más abajo que la
     anterior — al cubrirse, lo último visible de cada tapada es su franja
     de identidad. Móvil: flujo nativo. */
  @media (min-width: 721px) {
    .card {
      position: sticky;
      top: calc(clamp(3.5rem, 9vh, 4.5rem) + var(--card-index) * 4.5rem);
    }
  }

  .card a {
    display: block;
    text-decoration: none;
    color: var(--text);
    /* Elevación (A5): la carta existe como objeto sobre el fondo */
    background: var(--surface-1);
    border: var(--border-soft);
    border-radius: 4px;
    overflow: hidden;
    transition: outline-color var(--transition-fast);
    outline: 1px solid transparent;
  }
  .card a:hover {
    outline-color: var(--accent);
    /* Estado activo: sube un nivel de elevación */
    background: var(--surface-2);
    box-shadow: var(--shadow-2);
  }

  /* Franja de identidad: 72px fijos */
  .card-tab {
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: clamp(1.25rem, 3vw, 2rem);
    border-bottom: var(--border-soft);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card a:hover .card-title {
    color: var(--accent);
  }

  .card-meta {
    display: flex;
    flex-shrink: 0;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
    margin: 0;
  }

  .card-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: end;
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  /* Alternancia editorial: las pares invierten la composición */
  .card:nth-child(even) .card-inner {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .card:nth-child(even) .card-media {
    order: 2;
  }

  .card-media {
    overflow: hidden;
  }

  .card-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    transition: transform var(--dur-element) var(--ease-out-token);
  }

  .card a:hover .card-media img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-media img {
      transition: none;
    }
    .card a:hover .card-media img {
      transform: none;
    }
  }

  .card-summary {
    font-size: var(--step-body);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 48ch;
    margin: 0;
  }

  .featured-cta {
    display: block;
    width: fit-content;
    margin-inline: auto;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--transition-fast);
  }
  .featured-cta:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .card-tab {
      height: auto;
      min-height: 3.5rem;
      flex-wrap: wrap;
      padding-block: 0.75rem;
      gap: 0.25rem 1rem;
    }
    .card-title {
      white-space: normal;
    }
    .card-inner,
    .card:nth-child(even) .card-inner {
      grid-template-columns: 1fr;
    }
    .card:nth-child(even) .card-media {
      order: 0;
    }
  }
</style>
