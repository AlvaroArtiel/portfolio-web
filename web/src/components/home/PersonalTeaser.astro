---
import type {Lang} from '../../lib/i18n'
import {t, ui} from '../../lib/i18n'
import type {PersonalItem} from '../../lib/queries'
import {urlFor} from '../../lib/sanity'
import {pathFor} from '../../lib/routes'

interface Props {
  lang: Lang
  items: PersonalItem[]
}
const {lang, items} = Astro.props
const dict = ui[lang]

/** Rotación determinista a partir del _id (misma foto, mismo giro). */
const rotation = (id: string) => {
  let hash = 0
  for (const char of id) hash = (hash * 31 + char.charCodeAt(0)) % 997
  return ((hash % 9) - 4) * 1.5 // -6º..+6º
}

const photos = items.filter((item) => item.image).slice(0, 4)
---

{
  photos.length > 0 && (
    <section class="personal-teaser" data-reveal>
      <p class="section-kicker">{dict.personal_teaser_kicker}</p>
      <a class="teaser-stack" href={pathFor('personal', lang)}>
        {photos.map((item, index) => (
          <figure class="polaroid" style={`--rot: ${rotation(item._id)}deg; --i: ${index}`}>
            <img
              src={urlFor(item.image!, {w: 480, h: 360}).url()}
              alt={t(item.caption, lang) || ''}
              width="480"
              height="360"
              loading="lazy"
            />
            {t(item.caption, lang) && <figcaption>{t(item.caption, lang)}</figcaption>}
          </figure>
        ))}
        <span class="teaser-cta">{dict.personal_teaser_cta} →</span>
      </a>
    </section>
  )
}

<style>
  .personal-teaser {
    padding: clamp(4rem, 12vh, 8rem) clamp(1.5rem, 6vw, 4rem) clamp(5rem, 14vh, 9rem);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 2.5rem;
  }

  .teaser-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    text-decoration: none;
  }

  .polaroid {
    margin: 0;
    padding: 0.6rem 0.6rem 2rem;
    background: #fdfdf8;
    transform: rotate(var(--rot));
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.45);
    max-width: clamp(9rem, 18vw, 14rem);
    transition: transform var(--transition-base);
  }
  .teaser-stack:hover .polaroid {
    transform: rotate(calc(var(--rot) * 1.6)) translateY(-4px);
  }
  .polaroid + .polaroid {
    margin-left: clamp(-2.5rem, -4vw, -1rem);
  }

  .polaroid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .polaroid figcaption {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #333;
    padding-top: 0.5rem;
    text-align: center;
  }

  .teaser-cta {
    margin-left: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--transition-fast);
  }
  .teaser-stack:hover .teaser-cta {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser-stack:hover .polaroid {
      transform: rotate(var(--rot));
    }
  }
</style>
