---
import type {Lang} from '../../lib/i18n'
import {ui} from '../../lib/i18n'
import type {PersonalItem} from '../../lib/queries'
import {pathFor} from '../../lib/routes'
import PolaroidCard from '../personal/PolaroidCard.astro'

interface Props {
  lang: Lang
  items: PersonalItem[]
}
const {lang, items} = Astro.props
const dict = ui[lang]

const photos = items.filter((item) => item.image).slice(0, 4)
---

{
  photos.length > 0 && (
    <section class="personal-teaser" data-reveal>
      <p class="section-kicker">{dict.personal_teaser_kicker}</p>
      <a class="teaser-stack" href={pathFor('personal', lang)}>
        {photos.map((item) => (
          <PolaroidCard lang={lang} item={item} interactive={false} />
        ))}
        <span class="teaser-cta">{dict.personal_teaser_cta} →</span>
      </a>
    </section>
  )
}

<style>
  .personal-teaser {
    padding: clamp(4rem, 12vh, 8rem) clamp(1.5rem, 6vw, 4rem) clamp(5rem, 14vh, 9rem);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--accent);
    margin: 0 0 2.5rem;
  }

  .teaser-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    text-decoration: none;
  }

  .teaser-stack :global(.polaroid) {
    max-width: clamp(9rem, 18vw, 14rem);
  }
  .teaser-stack:hover :global(.polaroid) {
    transform: rotate(calc(var(--rot) * 1.6)) translateY(-4px);
  }
  .teaser-stack :global(.polaroid) + :global(.polaroid) {
    margin-left: clamp(-2.5rem, -4vw, -1rem);
  }

  .teaser-cta {
    margin-left: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2em;
    transition: color var(--transition-fast);
  }
  .teaser-stack:hover .teaser-cta {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser-stack:hover .polaroid {
      transform: rotate(var(--rot));
    }
  }
</style>
