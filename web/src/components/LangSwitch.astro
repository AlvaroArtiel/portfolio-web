---
import type {Lang} from '../lib/i18n'
import {altPath} from '../lib/routes'

interface Props {
  lang: Lang
}
const {lang} = Astro.props
const pathname = Astro.url.pathname
const esHref = altPath(pathname, 'es')
const enHref = altPath(pathname, 'en')
---

<nav class="lang-switch" aria-label={lang === 'en' ? 'Language' : 'Idioma'}>
  <a href={esHref} aria-current={lang === 'es' ? 'true' : undefined} lang="es" title="Español" aria-label="Español">ES</a>
  <span aria-hidden="true">/</span>
  <a href={enHref} aria-current={lang === 'en' ? 'true' : undefined} lang="en" title="English" aria-label="English">EN</a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
  }
  .lang-switch a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .lang-switch a:hover {
    color: var(--text);
  }
  .lang-switch a[aria-current='true'] {
    color: var(--accent);
  }
</style>
