<style>
  .placeholder-hero {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: clamp(1.5rem, 6vw, 4rem);
  }
  .placeholder-hero h1 {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .placeholder-hero p {
    font-family: var(--font-mono);
    font-size: var(--step-mono-label);
    color: var(--text-muted);
  }
</style>
